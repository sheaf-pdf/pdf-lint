# The model's TSVs stay byte for byte as upstream ships them, whatever a
# checkout's line-ending settings, and so does pdf-lint's copy of its
# NOTICE.txt, which a test holds to it.
crates/pdf-arlington/model/** -text
crates/pdf-lint/ARLINGTON-NOTICE.txt -text

# Shell scripts run under bash on every runner, Windows too, where a CR
# would break them.
*.sh text eol=lf

# PDF files are bytes: a checkout mustn't touch their line endings.
*.pdf binary
